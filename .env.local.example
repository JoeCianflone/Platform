# ─── CORS ───────────────────────────────────────────────────────────────────
# Production: set to your exact domain(s), comma-separated.
# Leave blank to default to APP_URL.
# CORS_ALLOWED_ORIGINS=https://example.com

# ─── Horizon ────────────────────────────────────────────────────────────────
# HORIZON_NAME=
# HORIZON_DOMAIN=
# HORIZON_PREFIX=
# HORIZON_PATH=horizon
# Comma-separated emails allowed to access /horizon in production:
# HORIZON_AUTHORIZED_EMAILS=you@example.com

# ─── Sentry ─────────────────────────────────────────────────────────────────
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Reverb (WebSockets) ────────────────────────────────────────────────────
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# ─── Stripe / Cashier ───────────────────────────────────────────────────────
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# CASHIER_CURRENCY=usd

# ─── Meilisearch ────────────────────────────────────────────────────────────
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_KEY=

