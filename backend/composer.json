{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "joecianflone/platform",
    "type": "project",
    "description": "",
    "keywords": [
        "laravel",
        "platform",
        "vue",
        "typescript"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/filament": ">=5.6.7",
        "http-interop/http-factory-guzzle": ">=1.2.1",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/cashier": ">=16.5.3",
        "laravel/framework": "^13.15",
        "laravel/horizon": ">=5.47.2",
        "laravel/pennant": ">=1.23",
        "laravel/reverb": ">=1.10.2",
        "laravel/scout": ">=11.2",
        "laravel/socialite": ">=5.27",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "dev-next",
        "meilisearch/meilisearch-php": ">=1.16.1",
        "sentry/sentry-laravel": ">=4.25.1",
        "spatie/laravel-medialibrary": ">=11.23",
        "spatie/laravel-permission": ">=8"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": ">=3.7",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.4.10",
        "laravel/pail": "^1.2.7",
        "laravel/pao": ">=1.1",
        "laravel/pint": "^1.29.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.7.2",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "modules/*",
            "options": {
                "symlink": true
            }
        }
    ]
}
