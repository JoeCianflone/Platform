{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "ignoreDeprecations": "6.0",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "app.ts",
    "app.css",
    "components/**/*.ts",
    "components/**/*.vue",
    "composables/**/*.ts",
    "domains/**/*.ts",
    "domains/**/*.vue",
    "pages/**/*.ts",
    "pages/**/*.vue",
    "wayfinder/**/*.ts",
    "types/**/*.ts"
  ]
}
